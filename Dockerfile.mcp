# Dockerfile do runtime MCP (Streamable HTTP) com contexto de build na RAIZ do repositório.
# Uso no EasyPanel: Build -> Dockerfile -> File = "Dockerfile.mcp" (contexto = raiz).
# Equivalente ao shopflow-catalog-ai/Dockerfile, mas copiando a subpasta shopflow-catalog-ai/.
FROM node:22-alpine AS builder

WORKDIR /app

COPY shopflow-catalog-ai/package*.json ./
RUN npm ci

COPY shopflow-catalog-ai/tsconfig.json ./
COPY shopflow-catalog-ai/src/ ./src/

RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV MCP_PORT=3000
ENV RUN_HTTP_SERVER=true

COPY shopflow-catalog-ai/package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/health || exit 1

CMD ["node", "dist/server-http.js"]
